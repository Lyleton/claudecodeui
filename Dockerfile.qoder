FROM node:22-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    python3 \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install --silent

COPY . .
RUN npm run build

ENV SERVER_PORT=3001
ENV HOST=0.0.0.0

EXPOSE 3001

CMD ["npm", "run", "server"]
